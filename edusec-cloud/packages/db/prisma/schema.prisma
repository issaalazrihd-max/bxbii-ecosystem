// EduSec Cloud — Phase 2 foundation schema.
//
// This models the PLATFORM FOUNDATION only (identity, RBAC, branch scoping,
// audit, and a minimal vertical slice of Student/Employee/Inventory to prove
// the multi-branch pattern end to end) as specified in:
// - EduSec Cloud — Phase 1 Analysis & Architecture Roadmap
// - EduSec Cloud — Multi-Branch Data Architecture & Transfer Workflows
//
// The full 65-section ERP schema (accounting, timetable, exams, facilities,
// etc.) is intentionally out of scope for this scaffold — it lands in later
// roadmap phases against this same foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenancy (fixed to one row in v1 — Section 13 of the Multi-Branch doc)
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches           Branch[]
  users              User[]
  roles              Role[]
  pages              Page[]
  navigationItems    NavigationItem[]
  programs           Program[]
  courses            Course[]
  contactSubmissions ContactSubmission[]
  partners           Partner[]
  batches            Batch[]
  enrollments        Enrollment[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Branches (Multi-Branch doc, Section 3.1)
// ---------------------------------------------------------------------------

enum BranchType {
  HEAD_OFFICE
  BRANCH
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  branchCode     String       @map("branch_code")
  branchName     String       @map("branch_name")
  branchType     BranchType   @default(BRANCH) @map("branch_type")
  parentBranchId String?      @map("parent_branch_id")
  parentBranch   Branch?      @relation("BranchHierarchy", fields: [parentBranchId], references: [id])
  childBranches  Branch[]     @relation("BranchHierarchy")
  addressLine1   String?      @map("address_line1")
  addressLine2   String?      @map("address_line2")
  city           String?
  country        String?
  phone          String?
  email          String?
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  usersPrimary            User[]                     @relation("UserPrimaryBranch")
  userBranchAccess        UserBranchAccess[]
  studentsPrimary         Student[]                  @relation("StudentPrimaryBranch")
  studentsCurrent         Student[]                  @relation("StudentCurrentBranch")
  studentBranchHistory    StudentBranchHistory[]
  transfersFrom           StudentTransferRequest[]   @relation("TransferFromBranch")
  transfersTo             StudentTransferRequest[]   @relation("TransferToBranch")
  transferHistoryFrom     StudentTransferHistory[]   @relation("TransferHistoryPrevBranch")
  transferHistoryTo       StudentTransferHistory[]   @relation("TransferHistoryNewBranch")
  employeesPrimary        Employee[]                 @relation("EmployeePrimaryBranch")
  employeeAssignments     EmployeeBranchAssignment[]
  trainersPrimary         Trainer[]                  @relation("TrainerPrimaryBranch")
  inventoryItems          InventoryItem[]
  inventoryTransfersOut   InventoryTransfer[]        @relation("InventoryTransferSource")
  inventoryTransfersIn    InventoryTransfer[]        @relation("InventoryTransferDestination")
  crossBranchLogs         CrossBranchAccessLog[]
  batches                 Batch[]

  @@unique([tenantId, branchCode])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identity, roles & permissions
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model User {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  email           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  status          UserStatus @default(ACTIVE)
  primaryBranchId String?    @map("primary_branch_id")
  primaryBranch   Branch?    @relation("UserPrimaryBranch", fields: [primaryBranchId], references: [id])
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  roles          UserRole[]
  branchAccess   UserBranchAccess[] @relation("UserBranchAccessUser")
  grantedAccess  UserBranchAccess[] @relation("UserBranchAccessGrantedBy")
  auditLogs      AuditLog[]
  crossBranchLogs CrossBranchAccessLog[]
  refreshTokens  RefreshToken[]
  createdPages   Page[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// Pre-built role templates (Section 43 of the EduSec Cloud brief) — unlike
/// the legacy Yii "Rights" extension, which shipped with zero seeded roles
/// (Phase 1 Analysis, Section 2.7), EduSec Cloud ships these out of the box.
model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// One row per module.action — mirrors the granularity of the legacy Rights
/// engine (Phase 1 Analysis, Section 2.7) but with pre-defined roles on top.
model Permission {
  id     String @id @default(uuid())
  module String
  action String
  code   String @unique // e.g. "students.create"

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Branch access control (Multi-Branch doc, Section 4)
// ---------------------------------------------------------------------------

/// Branch Private is the unconfigured default and needs no row here — only
/// the three explicit grant levels are modeled (Section 4.1-4.2).
enum BranchAccessLevel {
  CROSS_BRANCH_VIEW
  CROSS_BRANCH_EDIT
  HEAD_OFFICE
}

model UserBranchAccess {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  user           User              @relation("UserBranchAccessUser", fields: [userId], references: [id])
  // Null branchId + HEAD_OFFICE level = implicit access to ALL branches
  // without one row per branch (Multi-Branch doc, Section 4.1). A non-null
  // branchId scopes CROSS_BRANCH_VIEW/CROSS_BRANCH_EDIT to that one branch.
  branchId       String?           @map("branch_id")
  branch         Branch?           @relation(fields: [branchId], references: [id])
  accessLevel    BranchAccessLevel @map("access_level")
  moduleScope    String?           @map("module_scope") // null = applies to all modules
  grantedById    String?           @map("granted_by")
  grantedBy      User?             @relation("UserBranchAccessGrantedBy", fields: [grantedById], references: [id])
  grantedAt      DateTime          @default(now()) @map("granted_at")

  @@map("user_branch_access")
}

// ---------------------------------------------------------------------------
// Audit (Phase 1 Architecture, Section 4.5 + Multi-Branch doc, Section 12)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId])
  @@map("audit_log")
}

enum CrossBranchEventType {
  VIEW
  EDIT
  STUDENT_TRANSFER
  INVENTORY_TRANSFER
  FINANCIAL_TRANSFER
  PERMISSION_GRANT
}

/// A tagged subset of audit events specific to cross-branch boundary
/// crossings (Multi-Branch doc, Section 12) — not a parallel logging system.
model CrossBranchAccessLog {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  actorId        String?              @map("actor_id")
  actor          User?                @relation(fields: [actorId], references: [id])
  eventType      CrossBranchEventType @map("event_type")
  targetBranchId String               @map("target_branch_id")
  targetBranch   Branch               @relation(fields: [targetBranchId], references: [id])
  entityType     String               @map("entity_type")
  entityId       String               @map("entity_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([tenantId, targetBranchId])
  @@map("cross_branch_access_log")
}

// ---------------------------------------------------------------------------
// Student — unified institute-wide identity (Multi-Branch doc, Section 5)
// ---------------------------------------------------------------------------

enum StudentStatus {
  LEAD
  APPLICANT
  PENDING
  ACTIVE
  ON_HOLD
  SUSPENDED
  WITHDRAWN
  COMPLETED
  GRADUATED
}

model Student {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  studentCode     String        @map("student_code") // permanent, institute-wide, never reissued
  firstName       String        @map("first_name")
  middleName      String?       @map("middle_name")
  lastName        String        @map("last_name")
  gender          String?
  dateOfBirth     DateTime?     @map("date_of_birth")
  email           String?
  mobile          String?
  status          StudentStatus @default(LEAD)
  primaryBranchId String        @map("primary_branch_id")
  primaryBranch   Branch        @relation("StudentPrimaryBranch", fields: [primaryBranchId], references: [id])
  currentBranchId String        @map("current_branch_id")
  currentBranch   Branch        @relation("StudentCurrentBranch", fields: [currentBranchId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  branchHistory    StudentBranchHistory[]
  transferRequests StudentTransferRequest[]
  transferHistory  StudentTransferHistory[]
  enrollments      Enrollment[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, currentBranchId])
  @@map("students")
}

/// Append-only — derived automatically as transfers complete (Section 5.1).
model StudentBranchHistory {
  id        String    @id @default(uuid())
  studentId String    @map("student_id")
  student   Student   @relation(fields: [studentId], references: [id])
  branchId  String    @map("branch_id")
  branch    Branch    @relation(fields: [branchId], references: [id])
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  @@index([studentId])
  @@map("student_branch_history")
}

enum TransferStatus {
  REQUESTED
  CURRENT_BRANCH_REVIEW
  RECEIVING_BRANCH_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum FinancialTransferPolicy {
  FULL_TRANSFER
  HISTORICAL_REMAINS
  MANUAL_SETTLEMENT
}

/// In-flight, mutable workflow record (Multi-Branch doc, Section 6.1).
model StudentTransferRequest {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  studentId String @map("student_id")
  student  Student @relation(fields: [studentId], references: [id])

  fromBranchId String @map("from_branch_id")
  fromBranch   Branch @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranchId   String @map("to_branch_id")
  toBranch     Branch @relation("TransferToBranch", fields: [toBranchId], references: [id])

  reason String
  notes  String?
  status TransferStatus @default(REQUESTED)

  // Section 6.2 — which record categories are in scope for this transfer.
  transferProfile            Boolean @default(true) @map("transfer_profile")
  transferDocuments          Boolean @default(true) @map("transfer_documents")
  transferAcademicHistory    Boolean @default(true) @map("transfer_academic_history")
  transferAttendanceHistory  Boolean @default(true) @map("transfer_attendance_history")
  transferCourseHistory      Boolean @default(true) @map("transfer_course_history")
  transferAssessmentResults  Boolean @default(true) @map("transfer_assessment_results")
  transferCertificates       Boolean @default(true) @map("transfer_certificates")
  transferFinancialHistory   Boolean @default(true) @map("transfer_financial_history")

  // Section 6.3
  financialPolicy FinancialTransferPolicy? @map("financial_policy")

  // Section 6.4 — pre-approval academic validation checklist result.
  academicValidation Json? @map("academic_validation")

  requestedById String   @map("requested_by")
  requestedAt   DateTime @default(now()) @map("requested_at")

  currentBranchReviewedById String?   @map("current_branch_reviewed_by")
  currentBranchReviewedAt   DateTime? @map("current_branch_reviewed_at")

  receivingBranchReviewedById String?   @map("receiving_branch_reviewed_by")
  receivingBranchReviewedAt   DateTime? @map("receiving_branch_reviewed_at")

  approvedById String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  completedAt  DateTime? @map("completed_at")

  @@index([tenantId, studentId])
  @@map("student_transfer_requests")
}

/// Immutable on completion — never edited afterward (Section 6.5).
model StudentTransferHistory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  studentId String @map("student_id")
  student  Student @relation(fields: [studentId], references: [id])

  previousBranchId String @map("previous_branch_id")
  previousBranch   Branch @relation("TransferHistoryPrevBranch", fields: [previousBranchId], references: [id])
  newBranchId      String @map("new_branch_id")
  newBranch        Branch @relation("TransferHistoryNewBranch", fields: [newBranchId], references: [id])

  transferDate          DateTime @map("transfer_date")
  requestedById         String   @map("requested_by")
  approvedById          String   @map("approved_by")
  reason                String
  notes                 String?
  academicStatus        String?  @map("academic_status")
  financialStatus       String?  @map("financial_status")
  categoriesTransferred Json     @map("categories_transferred")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([tenantId, studentId])
  @@map("student_transfer_history")
}

// ---------------------------------------------------------------------------
// Employee — minimal, to prove multi-branch assignment (Section 7)
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

model Employee {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  employeeCode    String         @map("employee_code")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  position        String?
  email           String?
  mobile          String?
  status          EmployeeStatus @default(ACTIVE)
  primaryBranchId String         @map("primary_branch_id")
  primaryBranch   Branch         @relation("EmployeePrimaryBranch", fields: [primaryBranchId], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  branchAssignments EmployeeBranchAssignment[]

  @@unique([tenantId, employeeCode])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Trainers (Phase 1 demo scope — full Trainer Management module lands later)
// ---------------------------------------------------------------------------

enum TrainerStatus {
  ACTIVE
  INACTIVE
}

model Trainer {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  trainerCode     String        @map("trainer_code")
  fullName        String        @map("full_name")
  specialization  String?
  email           String?
  mobile          String?
  teachingHours   Int           @default(0) @map("teaching_hours")
  status          TrainerStatus @default(ACTIVE)
  primaryBranchId String        @map("primary_branch_id")
  primaryBranch   Branch        @relation("TrainerPrimaryBranch", fields: [primaryBranchId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  batches Batch[]

  @@unique([tenantId, trainerCode])
  @@map("trainers")
}

model EmployeeBranchAssignment {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  branchId     String    @map("branch_id")
  branch       Branch    @relation(fields: [branchId], references: [id])
  isPrimary    Boolean   @default(false) @map("is_primary")
  roleAtBranch String?   @map("role_at_branch")
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")

  @@index([employeeId])
  @@index([branchId])
  @@map("employee_branch_assignments")
}

// ---------------------------------------------------------------------------
// Inventory transfer (Multi-Branch doc, Section 8) — minimal item model
// ---------------------------------------------------------------------------

model InventoryItem {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  branch         Branch   @relation(fields: [branchId], references: [id])
  itemCode       String   @map("item_code")
  name           String
  category       String?
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  minQuantity    Int      @default(0) @map("min_quantity")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  transferLines InventoryTransferItem[]

  @@unique([tenantId, itemCode])
  @@index([branchId])
  @@map("inventory_items")
}

enum InventoryTransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model InventoryTransfer {
  id                  String                   @id @default(uuid())
  tenantId            String                   @map("tenant_id")
  sourceBranchId      String                   @map("source_branch_id")
  sourceBranch        Branch                   @relation("InventoryTransferSource", fields: [sourceBranchId], references: [id])
  destinationBranchId String                   @map("destination_branch_id")
  destinationBranch   Branch                   @relation("InventoryTransferDestination", fields: [destinationBranchId], references: [id])
  status              InventoryTransferStatus  @default(REQUESTED)
  requestedById       String                   @map("requested_by")
  approvedById        String?                  @map("approved_by")
  receivedById        String?                  @map("received_by")
  requestedAt         DateTime                 @default(now()) @map("requested_at")
  dispatchedAt        DateTime?                @map("dispatched_at")
  receivedAt          DateTime?                @map("received_at")

  items InventoryTransferItem[]

  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id         String             @id @default(uuid())
  transferId String             @map("transfer_id")
  transfer   InventoryTransfer  @relation(fields: [transferId], references: [id])
  itemId     String             @map("item_id")
  item       InventoryItem      @relation(fields: [itemId], references: [id])
  quantity   Int

  @@map("inventory_transfer_items")
}

// ---------------------------------------------------------------------------
// CMS & Page Builder (bxbii Ecosystem brief, Sections 2, 29-31) — platform-
// wide, shared data: not branch-scoped, since the public website is one
// front door for the whole tenant, not any one branch.
// ---------------------------------------------------------------------------

enum PageStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// A CMS-managed page (Section 29). "isSystem" marks pages the platform
/// relies on structurally (e.g. Home) so the admin UI can warn before
/// deleting them, without hard-coding the page itself in application code.
model Page {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  slug        String // "" (empty) reserved for the home page
  arTitle     String     @map("ar_title")
  enTitle     String     @map("en_title")
  status      PageStatus @default(DRAFT)
  isSystem    Boolean    @default(false) @map("is_system")
  createdById String?    @map("created_by")
  createdBy   User?      @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  sections        PageSection[]
  navigationLinks NavigationItem[]

  @@unique([tenantId, slug])
  @@map("pages")
}

/// One block within a page (Section 30 — the Page Builder's block palette).
/// Content is bilingual-by-field (Section 28) rather than one blob per
/// language, so a section's Arabic and English content can be edited
/// independently without re-sending the whole block.
///
/// PROGRAMS was added alongside the homepage's Tuwaiq-inspired restructure
/// so the Programs module (already backing the dedicated /programs page)
/// can also appear as a real-data page-builder block, the same way Courses
/// and Partners already do — no new backend module, just a new block type
/// reading the existing Program table.
enum PageSectionType {
  HERO
  HEADING
  TEXT
  IMAGE
  VIDEO
  BUTTON
  PRODUCTS
  PROGRAMS
  COURSES
  PROJECTS
  GALLERY
  TEAM
  PARTNERS
  CONTACT_FORM
  FILES
  PDF
  CUSTOM
}

model PageSection {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  pageId      String          @map("page_id")
  page        Page            @relation(fields: [pageId], references: [id])
  sectionType PageSectionType @map("section_type")
  position    Int             @default(0)
  isVisible   Boolean         @default(true) @map("is_visible")
  // Shape depends on sectionType, e.g. HERO: {headline, subheadline, imageUrl,
  // ctaLabel, ctaHref}; PRODUCTS/COURSES/PROJECTS: {ids: string[]} — validated
  // in the API layer per type rather than with a rigid DB schema, so new
  // block types (Section 30's "Add New Block Types") don't need a migration.
  arContent Json @default("{}") @map("ar_content")
  enContent Json @default("{}") @map("en_content")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pageId, position])
  @@map("page_sections")
}

/// Fully dynamic navigation (Section 31) — no menu item is hard-coded.
enum NavigationLinkType {
  PAGE
  EXTERNAL_URL
  COURSE
  PROJECT
  PRODUCT
}

model NavigationItem {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  arLabel      String             @map("ar_label")
  enLabel      String             @map("en_label")
  linkType     NavigationLinkType @map("link_type")
  // Exactly one of targetPageId / externalUrl is set today; courseId /
  // projectId / productId (Section 31) are reserved for when those modules
  // exist and resolve the same way targetPageId does.
  targetPageId String?  @map("target_page_id")
  targetPage   Page?    @relation(fields: [targetPageId], references: [id])
  externalUrl  String?  @map("external_url")
  openInNewTab Boolean  @default(false) @map("open_in_new_tab")
  parentId     String?  @map("parent_id")
  parent       NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id])
  children     NavigationItem[] @relation("NavigationHierarchy")
  position     Int      @default(0)
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId, parentId, position])
  @@map("navigation_items")
}

/// Training/business programs shown on the public /programs page (bxbii
/// Ecosystem brief — Programs module). Platform-wide like Page/NavigationItem
/// above, not branch-scoped: the programs catalog is one shared list for the
/// whole tenant, same as the rest of the CMS. "OPEN" programs may carry an
/// hrefOverride (e.g. "/training") pointing at a dedicated, richer page for
/// that program; "COMING_SOON" programs have no link and the public site
/// renders them as a disabled, honestly-labeled placeholder card.
enum ProgramStatus {
  OPEN
  COMING_SOON
}

model Program {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  slug            String
  arDomain        String        @map("ar_domain")
  enDomain        String        @map("en_domain")
  arName          String        @map("ar_name")
  enName          String        @map("en_name")
  arDescription   String        @map("ar_description")
  enDescription   String        @map("en_description")
  arDuration      String        @map("ar_duration")
  enDuration      String        @map("en_duration")
  arFormat        String        @map("ar_format")
  enFormat        String        @map("en_format")
  status          ProgramStatus @default(COMING_SOON)
  hrefOverride    String?       @map("href_override")
  position        Int           @default(0)
  isVisible       Boolean       @default(true) @map("is_visible")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  batches Batch[]

  @@unique([tenantId, slug])
  @@index([tenantId, position])
  @@map("programs")
}

// ---------------------------------------------------------------------------
// Courses (bxbii Ecosystem brief — Courses module) — individual course cards
// shown on the COURSES page-builder block. Platform-wide like Page/
// NavigationItem/Program above, not branch-scoped: the course catalog is one
// shared list for the whole tenant. Modeled directly on Program's shape
// (same OPEN/COMING_SOON two-tier status, position + isVisible ordering,
// optional hrefOverride to a dedicated page) minus Program's arDomain/
// enDomain grouping fields — a Course is itself the flat, individual catalog
// item, the same relationship Partner has to Program's admin pattern.
// ---------------------------------------------------------------------------

enum CourseStatus {
  OPEN
  COMING_SOON
}

model Course {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  slug          String
  arTitle       String       @map("ar_title")
  enTitle       String       @map("en_title")
  arDescription String       @map("ar_description")
  enDescription String       @map("en_description")
  arDuration    String       @map("ar_duration")
  enDuration    String       @map("en_duration")
  arFormat      String       @map("ar_format")
  enFormat      String       @map("en_format")
  status        CourseStatus @default(COMING_SOON)
  hrefOverride  String?      @map("href_override")
  position      Int          @default(0)
  isVisible     Boolean      @default(true) @map("is_visible")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  batches Batch[]

  @@unique([tenantId, slug])
  @@index([tenantId, position])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// Partners (bxbii Ecosystem brief — Partners module) — logos shown on the
// PARTNERS page-builder block. Platform-wide like Page/NavigationItem/
// Program above, not branch-scoped: the partner roster is one shared list
// for the whole tenant. Modeled directly on Program's admin shape (position
// + isVisible, same ordering/visibility semantics) since a partner has no
// bilingual content of its own — just a name, a logo, and an optional link.
// ---------------------------------------------------------------------------

model Partner {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  logoUrl    String   @map("logo_url")
  websiteUrl String?  @map("website_url")
  position   Int      @default(0)
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId, position])
  @@map("partners")
}

// ---------------------------------------------------------------------------
// Contact submissions (bxbii Ecosystem brief — Contact module) — messages
// visitors send from the public /contact-us page's CONTACT_FORM block.
// Platform-wide like Page/NavigationItem/Program above, not branch-scoped:
// the public website is one front door for the whole tenant, not any one
// branch. Unlike Program, this is an inbox of citizen-submitted rows, not
// editorial content, so it carries no isVisible/position fields — every
// submission is real and ordering is purely by recency (createdAt).
// ---------------------------------------------------------------------------

enum ContactSubmissionStatus {
  NEW
  READ
  ARCHIVED
}

model ContactSubmission {
  id        String                   @id @default(uuid())
  tenantId  String                   @map("tenant_id")
  tenant    Tenant                   @relation(fields: [tenantId], references: [id])
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactSubmissionStatus  @default(NEW)
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("contact_submissions")
}

// ---------------------------------------------------------------------------
// ERP — Institute Management, Phase 1: Batches & Enrollment.
//
// The platform previously had Student, Program, Course, Trainer, and Branch
// as independent models with no relations connecting them — there was no
// way to schedule a class or register a student into one (the user's direct
// question: "how do I register students... need to add batches, scheduled,
// and ability to edit the details of them all"). This closes that gap.
//
// Batch is branch-scoped like Student/Trainer/InventoryItem above (a real
// scheduled class runs at one physical branch) and reuses the same
// BranchScopeService access-control pattern already proven on Students —
// no new authorization mechanism introduced. Enrollment links Student to
// Batch and is scoped transitively through its Batch's branch.
// ---------------------------------------------------------------------------

enum BatchStatus {
  PLANNED
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A scheduled run of a Program or Course at one branch, with an optional
/// trainer, dates, and a seat capacity. Exactly one of programId/courseId
/// is expected to be set (enforced in the API layer, same as Prisma's
/// existing per-type JSON validation on PageSection above) — mirrors the
/// Program/Course split already in the catalog rather than inventing a
/// third "offering" concept.
model Batch {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  branchId  String      @map("branch_id")
  branch    Branch      @relation(fields: [branchId], references: [id])
  programId String?     @map("program_id")
  program   Program?    @relation(fields: [programId], references: [id])
  courseId  String?     @map("course_id")
  course    Course?     @relation(fields: [courseId], references: [id])
  trainerId String?     @map("trainer_id")
  trainer   Trainer?    @relation(fields: [trainerId], references: [id])
  batchCode String      @map("batch_code")
  arLabel   String?     @map("ar_label")
  enLabel   String?     @map("en_label")
  startDate DateTime    @map("start_date")
  endDate   DateTime?   @map("end_date")
  schedule  String? // free text, e.g. "Sat/Mon/Wed 6-9pm"
  capacity  Int         @default(0)
  status    BatchStatus @default(PLANNED)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  enrollments Enrollment[]

  @@unique([tenantId, batchCode])
  @@index([tenantId, branchId])
  @@map("batches")
}

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  COMPLETED
  WITHDRAWN
  CANCELLED
}

/// Links a Student to a Batch — this is the previously-missing piece behind
/// "how do I register students into a scheduled class" (Institute
/// Management System, ERP Phase 1).
model Enrollment {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  studentId      String           @map("student_id")
  student        Student          @relation(fields: [studentId], references: [id])
  batchId        String           @map("batch_id")
  batch          Batch            @relation(fields: [batchId], references: [id])
  status         EnrollmentStatus @default(ENROLLED)
  enrollmentDate DateTime         @default(now()) @map("enrollment_date")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([studentId, batchId])
  @@index([tenantId, batchId])
  @@index([tenantId, studentId])
  @@map("enrollments")
}
